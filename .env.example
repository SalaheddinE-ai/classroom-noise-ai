# Copy to .env and adjust. All keys use the CNAI_ prefix (except HF_TOKEN).
# Every setting below is shown with its default; uncomment to change it.

# ---- Paths
# CNAI_DATA_DIR=data
# CNAI_DATABASE_URL=

# ---- Audio capture
# CNAI_SAMPLE_RATE=16000
# CNAI_CHUNK_SECONDS=2.0
# CNAI_HOP_SECONDS=1.0
# CNAI_INPUT_DEVICE=
# CNAI_OUTPUT_DEVICE=
# CNAI_AUDIO_BACKEND=sounddevice

# ---- Thresholds
# CNAI_THRESHOLD_DB=68.0
# Pseudo-dB = 20*log10(RMS of int16 samples) + offset. Calibrate the offset against a sound level meter to obtain approximate dB SPL.
# CNAI_CALIBRATION_OFFSET_DB=0.0
# CNAI_VAD_THRESHOLD=0.5
# CNAI_VAD_MIN_SPEECH_RATIO=0.3
# CNAI_OVERLAP_RATIO_THRESHOLD=0.2
# CNAI_EMBEDDING_DISPERSION_THRESHOLD=0.35
# CNAI_SPEAKER_MATCH_THRESHOLD=0.75
# CNAI_EMBEDDING_DIM=192
# CNAI_COOLDOWN_SECONDS=20.0

# ---- Multi-speaker identification
# Minimum amount of speech (seconds) a speaker stream needs before we try to identify it.
# CNAI_MIN_IDENTIFY_SECONDS=1.0
# Voice samples (most recent first) averaged into one profile per student.
# CNAI_SAMPLES_PER_STUDENT=5
# A student with fewer usable samples than this is never matched ("needs samples").
# CNAI_MIN_VOICE_SAMPLES=1
# Best-vs-second-best margin: below it, an ambiguous match is reported as Unknown Speaker.
# CNAI_MIN_MATCH_MARGIN=0.05
# Maximum number of simultaneous speakers reported per window.
# CNAI_MAX_SIMULTANEOUS_SPEAKERS=3
# 0 (strict) .. 1 (sensitive). When unset, overlap_ratio_threshold / embedding_dispersion_threshold apply.
# CNAI_OVERLAP_SENSITIVITY=
# How unidentified speakers are handled: report them as "Unknown Speaker" (default), keep them in the events but never speak a warning because of them, or drop them.
# CNAI_UNKNOWN_SPEAKER_HANDLING=report
# Per-speaker cooldown (seconds); the global cooldown above still applies on top of it.
# CNAI_SPEAKER_COOLDOWN_SECONDS=20.0
# Detections closer than this (seconds) belong to the same alert.
# CNAI_EVENT_MERGE_GAP_SECONDS=3.0
# Cosine similarity above which two unidentified streams are considered the same voice.
# CNAI_UNKNOWN_CLUSTER_SIMILARITY=0.6
# Window scan fallback (no separation / diarization): sliding window for embeddings.
# CNAI_SCAN_WINDOW_SECONDS=1.0
# CNAI_SCAN_HOP_SECONDS=0.5
# New sample vs. the student's existing profile: below this it is rejected (wrong person?).
# CNAI_SAMPLE_CONSISTENCY_THRESHOLD=0.3
# A first sample this close to ANOTHER student's profile is refused as a probable duplicate.
# CNAI_DUPLICATE_VOICE_THRESHOLD=0.85
# CNAI_MIN_SAMPLE_SECONDS=1.5

# ---- V2.1: VAD segmentation, temporal tracking, warning policy
# CNAI_VAD_MIN_SPEECH_MS=100
# CNAI_VAD_MERGE_GAP_MS=300
# CNAI_VAD_PAD_MS=60
# An identity is "confirmed" only after this much distinct speech AND this many observations that agree on the same student; until then it is reported as "tentative".
# CNAI_TRACKER_CONFIRM_SECONDS=1.5
# CNAI_TRACKER_CONFIRM_HITS=2
# A weak observation (similarity within this margin below the threshold) of an already confirmed speaker of the same event is treated as a continuation, not as a new voice.
# CNAI_TRACKER_HYSTERESIS=0.08
# Mixture-embedding fallback needs this much extra similarity (mixed audio is less reliable).
# CNAI_MIXTURE_EXTRA_THRESHOLD=0.1
# Overlap strategy: auto picks sepformer > pyannote_slots > mixture_embedding when available.
# CNAI_OVERLAP_MODE=auto
# A first warning waits until a speaker is confirmed or the event has lasted this long (debounce: avoids warning "generally" a moment before the student can be named).
# CNAI_WARNING_GRACE_SECONDS=2.0
# Minimum gap between two spoken warnings (any speaker / type) so TTS is never chatty.
# CNAI_WARNING_MIN_GAP_SECONDS=3.0
# Name the identified students in spoken warnings (set false to keep warnings anonymous).
# CNAI_TTS_ANNOUNCE_NAMES=true

# ---- Enrollment quality / privacy
# Keep the enrollment recordings (needed to replay samples). The embeddings are always kept.
# CNAI_STORE_ENROLLMENT_AUDIO=false
# CNAI_ENROLLMENT_MAX_CLIP_RATIO=0.02
# CNAI_ENROLLMENT_MIN_RMS_DBFS=-50.0
# Peak-to-floor frame-energy range: a flat, noisy recording has little dynamic range.
# CNAI_ENROLLMENT_MIN_DYNAMIC_RANGE_DB=8.0
# Weight of the lowest-quality sample relative to a perfect one in the profile centroid.
# CNAI_MIN_SAMPLE_WEIGHT=0.3

# ---- Optional heavy components (off by default)
# Source separation (SpeechBrain SepFormer): gives real per-speaker audio, at a CPU/GPU cost.
# CNAI_SEPARATION_ENABLED=false
# CNAI_SEPARATION_MODEL=speechbrain/sepformer-wsj02mix
# CNAI_SEPARATION_SAMPLE_RATE=8000
# "auto": use the pyannote segmentation activity when the pyannote OSD backend is loaded.
# CNAI_DIARIZATION_BACKEND=auto

# ---- Visualisation / retention
# CNAI_VIZ_HISTORY_SECONDS=60.0
# CNAI_VIZ_POINTS_PER_SECOND=20
# 0 = never keep raw audio. > 0: keep short per-speaker clips of detected events this long.
# CNAI_RAW_AUDIO_RETENTION_SECONDS=0.0

# ---- Models
# CNAI_DEVICE=auto
# CNAI_SPEAKER_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
# CNAI_OSD_BACKEND=auto
# CNAI_PYANNOTE_MODEL=pyannote/segmentation-3.0
# CNAI_HF_TOKEN=

# ---- TTS
# CNAI_LANGUAGE=en
# CNAI_TTS_BACKEND=auto
# CNAI_TTS_VOLUME=1.0
# CNAI_PIPER_MODEL_PATH=
# CNAI_KOKORO_VOICE_EN=af_heart
# CNAI_KOKORO_VOICE_FR=ff_siwis
# CNAI_EDGE_VOICE_EN=en-US-AriaNeural
# CNAI_EDGE_VOICE_FR=fr-FR-DeniseNeural

# ---- Servers
# CNAI_API_HOST=127.0.0.1
# CNAI_API_PORT=8000
# CNAI_UI_PORT=8501

# HF_TOKEN=hf_xxx   # needed only for the pyannote overlap / segmentation model
