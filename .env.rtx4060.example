# classroom-noise-ai - starting profile for a laptop RTX 4060 (8 GB), real-time, SepFormer enabled.
# Copy over .env:   copy .env.rtx4060.example .env     (PowerShell: Copy-Item .env.rtx4060.example .env)
# These are STARTING POINTS, not validated values: tune the threshold with "Test my voice" in the dashboard.

# --- GPU
CNAI_DEVICE=cuda

# --- Overlapping speech: SepFormer (2 sources max with the default model)
CNAI_SEPARATION_ENABLED=true
CNAI_OVERLAP_MODE=sepformer
CNAI_MAX_SIMULTANEOUS_SPEAKERS=2
# SepFormer only runs when an overlap is detected. Best detector = pyannote (needs HF_TOKEN, see README).
# HF_TOKEN=hf_xxx
# CNAI_OSD_BACKEND=auto

# --- Loudness gate: identification only happens ABOVE this level. Normal speech at a laptop mic is often
# below the default 68, which makes you "never identified". Look at the live dB gauge and set it ~5 dB under
# your normal speaking level.
CNAI_THRESHOLD_DB=50

# --- Identification (a genuine voice on a live mic is often 0.45-0.65 cosine, rarely 0.75+)
CNAI_SPEAKER_MATCH_THRESHOLD=0.55
CNAI_MIN_MATCH_MARGIN=0.03
CNAI_MIN_IDENTIFY_SECONDS=0.8
CNAI_SAMPLES_PER_STUDENT=5

# --- Temporal tracking: tentative -> confirmed
CNAI_TRACKER_CONFIRM_SECONDS=1.2
CNAI_TRACKER_CONFIRM_HITS=2
CNAI_TRACKER_HYSTERESIS=0.10
CNAI_WARNING_GRACE_SECONDS=2.0
